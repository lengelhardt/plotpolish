{
  "$comment": "Single source of truth for the controls. TypeScript imports this; pytest reads it only for contract tests. groups = level-one categories in display order; tier primary = visible at once, more = under the 'More' expander; category: live = artist-level equivalent applied instantly, save = read by savefig, rerun = rcParams-only, needs a host re-run. See docs/ux-design.md. Two controls may share a key (prop_cycle presets and line_cycle both write axes.prop_cycle); each such control declares an owns map (rc key -> the parts of that key's value it is responsible for), so a category reset clears only its own parts instead of deleting the whole key and throwing away the other category's work. panelDefault: a value plotpolish applies when the block is first created if the key is not set.",
  "groups": [
    {
      "id": "look",
      "label": "Look",
      "help": "The overall style: preset and colors."
    },
    {
      "id": "text",
      "label": "Text",
      "help": "Sizes and font for every piece of text."
    },
    {
      "id": "lines",
      "label": "Lines",
      "help": "Plotted lines and markers."
    },
    {
      "id": "axes",
      "label": "Axes",
      "help": "Grid, the box around the plot, tick marks.",
      "subgroups": [
        {
          "id": "grid",
          "label": "Grid"
        },
        {
          "id": "box",
          "label": "Box and axes lines"
        },
        {
          "id": "ticks",
          "label": "Tick marks"
        }
      ]
    },
    {
      "id": "legend",
      "label": "Legend",
      "help": "Where the legend sits and how it is framed.",
      "hideWhen": "no-legend"
    },
    {
      "id": "save",
      "label": "Save",
      "help": "Applies when the figure is saved, not on screen."
    }
  ],
  "controls": [
    {
      "id": "prop_cycle",
      "group": "look",
      "tier": "primary",
      "label": "Colors",
      "type": "colorcycle",
      "keys": [
        "axes.prop_cycle"
      ],
      "owns": {
        "axes.prop_cycle": [
          "color"
        ]
      },
      "category": "live",
      "help": "The color given to the 1st, 2nd, \u2026 line (axes.prop_cycle). Applies to the lines already drawn and to new ones.",
      "default": [
        "#1f77b4",
        "#ff7f0e",
        "#2ca02c",
        "#d62728",
        "#9467bd",
        "#8c564b",
        "#e377c2",
        "#7f7f7f",
        "#bcbd22",
        "#17becf"
      ],
      "presets": [
        {
          "id": "tab10",
          "label": "matplotlib default",
          "colors": [
            "#1f77b4",
            "#ff7f0e",
            "#2ca02c",
            "#d62728",
            "#9467bd",
            "#8c564b",
            "#e377c2",
            "#7f7f7f",
            "#bcbd22",
            "#17becf"
          ]
        },
        {
          "id": "okabe-ito",
          "label": "Colorblind-safe (Okabe\u2013Ito)",
          "colors": [
            "#E69F00",
            "#56B4E9",
            "#009E73",
            "#F0E442",
            "#0072B2",
            "#D55E00",
            "#CC79A7",
            "#000000"
          ]
        },
        {
          "id": "tol-bright",
          "label": "Colorblind-safe (Tol bright)",
          "colors": [
            "#4477AA",
            "#EE6677",
            "#228833",
            "#CCBB44",
            "#66CCEE",
            "#AA3377",
            "#BBBBBB"
          ]
        }
      ]
    },
    {
      "id": "style",
      "group": "look",
      "tier": "primary",
      "label": "Styles",
      "type": "style",
      "keys": [],
      "default": "default",
      "category": "rerun",
      "help": "One of matplotlib's style sheets (plt.style.available). Sets many defaults at once; the other controls override it. Applies on the next run."
    },
    {
      "id": "font_size",
      "group": "text",
      "tier": "primary",
      "label": "Text size",
      "type": "number",
      "keys": [
        "font.size"
      ],
      "default": 10,
      "category": "live",
      "min": 6,
      "max": 24,
      "step": 0.5,
      "help": "Base size in points (font.size). Title, labels and legend scale from it unless set below."
    },
    {
      "id": "autolayout",
      "group": "text",
      "tier": "primary",
      "label": "Fit labels in figure",
      "type": "bool",
      "keys": [
        "figure.autolayout"
      ],
      "default": false,
      "panelDefault": true,
      "category": "live",
      "help": "Re-lays out the figure on every draw so axis labels and titles stay inside the edges (figure.autolayout, matplotlib's tight_layout). On by default, because enlarging text is the first thing most people do and it clips without this."
    },
    {
      "id": "title_size",
      "group": "text",
      "tier": "more",
      "label": "Title size",
      "type": "fontsize",
      "keys": [
        "axes.titlesize"
      ],
      "default": "large",
      "category": "live",
      "help": "axes.titlesize",
      "min": 6,
      "max": 40,
      "step": 0.5
    },
    {
      "id": "label_size",
      "group": "text",
      "tier": "more",
      "label": "Axis label size",
      "type": "fontsize",
      "keys": [
        "axes.labelsize"
      ],
      "default": "medium",
      "category": "live",
      "help": "axes.labelsize",
      "min": 6,
      "max": 40,
      "step": 0.5
    },
    {
      "id": "tick_label_size",
      "group": "text",
      "tier": "more",
      "label": "Tick label size",
      "type": "fontsize",
      "keys": [
        "xtick.labelsize",
        "ytick.labelsize"
      ],
      "default": "medium",
      "category": "live",
      "help": "xtick.labelsize and ytick.labelsize",
      "min": 6,
      "max": 40,
      "step": 0.5
    },
    {
      "id": "legend_fontsize",
      "group": "text",
      "tier": "more",
      "label": "Legend text size",
      "type": "fontsize",
      "keys": [
        "legend.fontsize"
      ],
      "default": "medium",
      "category": "live",
      "help": "legend.fontsize",
      "min": 6,
      "max": 40,
      "step": 0.5
    },
    {
      "id": "font_family",
      "group": "text",
      "tier": "more",
      "label": "Font",
      "type": "enum",
      "keys": [
        "font.family"
      ],
      "default": "sans-serif",
      "category": "live",
      "help": "font.family. Applied to the text already on the figure and to new text.",
      "options": [
        {
          "value": "sans-serif",
          "label": "Sans"
        },
        {
          "value": "serif",
          "label": "Serif"
        },
        {
          "value": "monospace",
          "label": "Mono"
        }
      ]
    },
    {
      "id": "line_cycle",
      "group": "lines",
      "tier": "primary",
      "label": "Per line",
      "type": "linecycle",
      "keys": [
        "axes.prop_cycle"
      ],
      "owns": {
        "axes.prop_cycle": [
          "linewidth",
          "linestyle"
        ]
      },
      "category": "live",
      "default": [
        "#1f77b4",
        "#ff7f0e",
        "#2ca02c",
        "#d62728",
        "#9467bd",
        "#8c564b",
        "#e377c2",
        "#7f7f7f",
        "#bcbd22",
        "#17becf"
      ],
      "help": "Color, width and style for the 1st, 2nd, \u2026 line in the order they are drawn (axes.prop_cycle). A line whose code sets its own color or width keeps it.",
      "minLines": 2,
      "maxLines": 8
    },
    {
      "id": "linewidth",
      "group": "lines",
      "tier": "primary",
      "label": "Line width (all)",
      "type": "number",
      "keys": [
        "lines.linewidth"
      ],
      "default": 1.5,
      "category": "live",
      "min": 0.5,
      "max": 8,
      "step": 0.25,
      "help": "lines.linewidth, in points"
